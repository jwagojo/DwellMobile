{
  "expo": {
    "name": "Dwell",
    "slug": "dwell-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dwell",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dwell.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.dwell.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F1DF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1DF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dwell uses the camera for the arrival and pickup photos of the parking spot, and for photos of your charger when you list it.",
          "photosPermission": "Dwell lets you choose photos of your driveway and charger for your listing, or a photo of the spot for a session.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dwell uses your location to find chargers near you, to place your listing's pin, and to check you're at the car when you pick it up.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
