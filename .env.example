# Copy to .env (git-ignored) and fill in the deployed stage's public values: the same four the web app's
# /config.json holds. None of them is a secret, but they stay out of git so each person can point at their stage.
EXPO_PUBLIC_DWELL_API_URL=https://example.execute-api.us-east-2.amazonaws.com/
EXPO_PUBLIC_DWELL_REGION=us-east-2
EXPO_PUBLIC_DWELL_USER_POOL_ID=us-east-2_EXAMPLE
EXPO_PUBLIC_DWELL_USER_POOL_CLIENT_ID=exampleclientid0000000000
